{
  "name": "mathematics-observatory",
  "description": "Grade 11 mathematics learning site with Gemini on Vercel and optional Ollama support",
  "private": true,
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "knowledge:build": "node scripts/build-knowledge-index.js",
    "knowledge:check": "node scripts/build-knowledge-index.js --check",
    "pretest": "npm run knowledge:check",
    "test": "node --test tests/grade11-ai.test.js tests/project-structure.test.js tests/gemini-api.test.js tests/observatory-math.test.js tests/visualize-interactions.test.js",
    "test:ollama": "node --test tests/grade11-ai-live.test.js"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "katex": "^0.16.22",
    "lenis": "^1.3.26",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.2"
  }
}
